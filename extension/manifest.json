{
  "manifest_version": 3,
  "name": "Atlas Guard Bridge",
  "version": "1.0.0",
  "description": "Monitora a Traderoom da Hezilex, aplica o padrão de 5 minutos e envia o estado real ao painel Atlas Guard.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://app.hezilex.com/*",
    "https://atlas-guard-trading.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://atlas-guard-trading.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["dashboard-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.hezilex.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Atlas Guard Bridge",
    "default_popup": "popup.html"
  }
}

